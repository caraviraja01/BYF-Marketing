# ── Claude (optional) ────────────────────────────────────────────────────────
# Leave blank to run in MOCK mode (realistic fake output, no network calls).
ANTHROPIC_API_KEY=
# Reasoning model (reliable structured output). See docs/ARCHITECTURE.md.
BYF_MODEL=claude-sonnet-4-6
# A cheaper/faster model for high-volume agents (research, verify). Optional.
BYF_FAST_MODEL=claude-haiku-4-5-20251001

# ── App ──────────────────────────────────────────────────────────────────────
BYF_DB_URL=sqlite:///data/byf.db
BYF_ENV=development

# ── Dashboard login ───────────────────────────────────────────────────────────
# Login is enforced ONLY when BYF_AUTH_PASSWORD is set (local dev stays open).
# Set both on any hosted deployment so the URL isn't publicly usable.
BYF_AUTH_USERNAME=admin
BYF_AUTH_PASSWORD=
# Signs the session cookie. Set a long random string in production
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
BYF_SECRET_KEY=
# Token that lets a cron service call /tasks/prepare-daily?token=... to prepare
# each day's calendar content automatically. Leave blank to disable the endpoint.
BYF_CRON_TOKEN=

# ── Creative generation ───────────────────────────────────────────────────────
# Canva (images / carousels). Falls back to "brief-only" mode when unset.
CANVA_API_KEY=
CANVA_BRAND_TEMPLATE_ID=
# Higgsfield (video). Auth is "Key <id>:<secret>"; put id in API_KEY, secret below
# (or put the whole "id:secret" in API_KEY and leave SECRET blank).
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=

# ── Pipeline behaviour ────────────────────────────────────────────────────────
# Simulate social publishing until real platform credentials are added.
BYF_SIMULATE_PUBLISH=true
# If a live agent call fails, fall back to a draft + warning instead of failing the
# whole run (keeps the dashboard populated). Set false to surface raw errors.
BYF_FALLBACK_TO_MOCK_ON_ERROR=true

# ── Social publishing (stubbed until you add credentials) ─────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
