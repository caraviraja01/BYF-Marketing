# ── Claude (optional) ────────────────────────────────────────────────────────
# Leave blank to run in MOCK mode (realistic fake output, no network calls).
ANTHROPIC_API_KEY=
# Latest, most capable Claude model. See docs/ARCHITECTURE.md for alternatives.
BYF_MODEL=claude-opus-4-8
# A cheaper/faster model for high-volume agents (research, verify). Optional.
BYF_FAST_MODEL=claude-haiku-4-5-20251001

# ── App ──────────────────────────────────────────────────────────────────────
BYF_DB_URL=sqlite:///data/byf.db
BYF_ENV=development

# ── Canva (creative generation) ───────────────────────────────────────────────
# Connector falls back to "brief-only" mode when unset.
CANVA_API_KEY=
CANVA_BRAND_TEMPLATE_ID=

# ── Social publishing (stubbed until you add credentials) ─────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
